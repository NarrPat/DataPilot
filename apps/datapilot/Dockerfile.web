# Exact image digests observed in DP-I010 dependency commands.
FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS build
WORKDIR /web
COPY apps/datapilot/web/package.json apps/datapilot/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/datapilot/contracts /contracts
COPY apps/datapilot/web ./
RUN npm run build

FROM nginx:stable-alpine@sha256:583b7f2fce1cdb8da5ad5c39ebd3c33b98b87d493190e548bdee1fa8c619c311
COPY apps/datapilot/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
