# Operator-only one-shot image. Never use this image for API/worker/control.
FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv
FROM python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/datapilot-venv
ENV PATH=/opt/datapilot-venv/bin:$PATH
ENV LANGSMITH_TRACING=false PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-cache
COPY datapilot ./datapilot
COPY apps/datapilot/catalog ./apps/datapilot/catalog
COPY apps/datapilot/migrations ./apps/datapilot/migrations
COPY apps/datapilot/alembic.ini ./apps/datapilot/alembic.ini
COPY apps/datapilot/app_migrations ./apps/datapilot/app_migrations
COPY apps/datapilot/app-alembic.ini ./apps/datapilot/app-alembic.ini
COPY fixtures/datapilot/tiny_v1.source.json ./fixtures/datapilot/tiny_v1.source.json
COPY fixtures/datapilot/demo_v1.source.json ./fixtures/datapilot/demo_v1.source.json
USER 10001:10001
ENTRYPOINT ["python", "-m", "datapilot.db.install"]
CMD ["upgrade"]
