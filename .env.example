# Local development values only. Generate .env.local with scripts/init-local-env.py.
COMPOSE_PROJECT_NAME=dp-local
DP_PROFILE=dev
DP_HTTP_PORT=18081
DP_COOKIE_NAME=dp_session
DP_CSRF_COOKIE_NAME=dp_csrf
# AuthConfig fixes cookie names by profile: dev/test add _dev; deploy uses names above.
# These legacy bootstrap fields do not permit overriding cookie isolation.
DP_POSTGRES_ADMIN_PASSWORD=
DP_APP_DB_PASSWORD=
DP_ANALYST_ALL_PASSWORD=
DP_ANALYST_EAST_PASSWORD=
DP_SESSION_SECRET=
DP_SEED_PASSWORD=
# Used only by the explicit local app account seed; never passed to a model.
# Provider selected; requests stay disabled until the live Spike is explicitly run.
DP_MODEL_MODE=none
# Explicit API acceptance flag; 1 requires a configured live worker/model mode.
# It checks configuration/dependencies, not a consumer heartbeat or live-model score.
DP_QUERY_PROCESSING_ENABLED=0
DP_MODEL_PROVIDER=deepseek
DP_MODEL_NAME=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
